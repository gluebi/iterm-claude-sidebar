# Caddy on another machine of the same network, in front of the Mac that runs the daemon.
# The daemon's config.json on the Mac must list this machine's address (allow_from) and the name below (allowed_hosts).
sidebar.example.org {
	# `caddy hash-password` prints the hash for this line
	basic_auth {
		alice $2a$14$REPLACE_WITH_THE_OUTPUT_OF_caddy_hash-password
	}

	# the Mac's LAN address and the daemon port
	reverse_proxy 192.168.1.20:47831
}

# LAN-only name without a public certificate: add `tls internal` inside the site block above.
